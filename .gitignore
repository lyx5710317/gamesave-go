# Binaries
*.exe
*.dll
*.so
*.dylib
/dist/
/build/

# Test artifacts
*.test
*.out
coverage.html

# Wails — ignore built frontend output but keep a placeholder so
# `go build ./...` works on a fresh clone (go:embed needs the dir).
cmd/opensave-app/frontend/dist/*
!cmd/opensave-app/frontend/dist/.gitkeep
cmd/opensave-app/frontend/node_modules/
cmd/opensave-app/build/bin/
# Downloaded, attested Actions candidates are local test artifacts.
cmd/opensave-app/build/candidate-*/

# IDE
.idea/
.vscode/

# OS
Thumbs.db
.DS_Store

# Generated by `wails build` on every run — bindings and the NSIS
# installer support files are regenerated in CI. The localized project.nsi
# is intentionally maintained here and must not be replaced by Wails' default.
cmd/opensave-app/frontend/wailsjs/
cmd/opensave-app/build/windows/installer/*
!cmd/opensave-app/build/windows/installer/project.nsi
